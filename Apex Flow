<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ShadowTech</title>
  <style>
    * { box-sizing: border-box; font-family: Arial, sans-serif; }
    body {
      margin: 0;
      background: #0b0b0b;
      color: white;
      text-align: center;
    }
    header {
      background: #f5c400;
      color: black;
      padding: 18px;
      font-size: 24px;
      font-weight: bold;
    }
    .hero {
      min-height: 300px;
      display: grid;
      place-content: center;
      border: 2px solid #f5c400;
      margin: 40px;
      border-radius: 14px;
    }
    h1 { font-size: 42px; }
    h1 span { color: #f5c400; }
    button {
      border: none;
      background: #f5c400;
      color: black;
      padding: 12px 24px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <header>SHADOW TECH</header>

  <main class="hero">
    <h1>BUILD YOUR <span>LEGACY</span></h1>
    <p>Anime-inspired technology for the next generation.</p>
    <button onclick="alert('Welcome to ShadowTech!')">
      START NOW
    </button>
  </main>
</body>
</html>
